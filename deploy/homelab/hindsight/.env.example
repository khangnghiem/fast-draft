# Hindsight Deployment Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git - it contains secrets

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_USER=hindsight
POSTGRES_PASSWORD=changeme-strong-password-here
POSTGRES_DB=hindsight

# ============================================================================
# Hindsight LLM Provider Configuration
# These should match what you copied to ~/.zshrc.secrets
# ============================================================================

# Provider: openai, anthropic, ollama, groq, gemini, lmstudio, minimax
HINDSIGHT_API_LLM_PROVIDER=groq

# API key for the provider (required for all except ollama/lmstudio)
HINDSIGHT_API_LLM_API_KEY=gsk-your-groq-api-key-here

# Model name - depends on provider:
#   groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
#   openai: gpt-4o-mini, gpt-4o
#   anthropic: claude-3-5-sonnet-20241022
#   ollama: llama3.2, gemma2, mistral
HINDSIGHT_API_LLM_MODEL=llama-3.3-70b-versatile

# Optional: Custom base URL for the LLM provider
# HINDSIGHT_API_LLM_BASE_URL=

# ============================================================================
# Hindsight Configuration
# ============================================================================

# Vector extension: pgvector (default), pgvectorscale, vchord, scann
HINDSIGHT_API_VECTOR_EXTENSION=pgvector

# Text search: native (default), vchord, pg_textsearch
HINDSIGHT_API_TEXT_SEARCH_EXTENSION=native

# File storage: native (default), s3, gcs, azure
HINDSIGHT_API_FILE_STORAGE_BACKEND=native

# Log level: debug, info (default), warning, error
HINDSIGHT_API_LOG_LEVEL=info

# Enable audit logging (true/false)
HINDSIGHT_API_AUDIT_LOG_ENABLED=false

# Admin password for web UI (optional but recommended)
# HINDSIGHT_API_ADMIN_PASSWORD=your-admin-password

# ============================================================================
# TailScale Configuration
# ============================================================================

# Get auth key from: https://login.tailscale.com/admin/settings/keys
# Generate a reusable, non-ephemeral key
TS_AUTHKEY=tskey-auth-your-key-here

# Hostname that appears in your TailScale admin console
TAILSCALE_HOSTNAME=hindsight-server

# Extra args (e.g., --advertise-routes=10.0.0.0/8)
# TAILSCALE_EXTRA_ARGS=

# ============================================================================
# Backup Configuration (Bi-weekly to iMac)
# ============================================================================

# iMac TailScale hostname or IP
IMAC_HOST=imac.tailnetname.ts.net

# iMac username (for SSH/SCP)
IMAC_USER=your-imac-username

# Backup directory on iMac (will be created if missing)
IMAC_BACKUP_DIR=/Users/${IMAC_USER}/pg_dumps

# Number of backups to keep on iMac (default: 12 = ~6 months)
KEEP_LAST=12

# ============================================================================
# End of Configuration
# ============================================================================
