# WASM, JS, CSS — all URLs are cache-busted with ?v=<git-sha> via
# pages.yml auto-bust step. Immutable = browsers never revalidate,
# return visitors get instant loads from disk cache.
/wasm/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Docs — cache-busted via ?v= in shared.css/docs.css links
/docs/*.html
  Cache-Control: public, max-age=3600
/docs/*.css
  Cache-Control: public, max-age=31536000, immutable

# All pages — security headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
