# ─── Styles ───

style decision_box {
  fill: #FEF3C7  # yellow
  corner: 4
}

style error_box {
  fill: #FEE2E2  # red
  corner: 8
}

style io_box {
  fill: #F3E8FF  # purple
  corner: 12
}

style process_box {
  fill: #EFF6FF  # blue
  corner: 8
}

style success_box {
  fill: #D1FAE5  # green
  corner: 8
}

# ─── Layout ───

# Start point
# [auto] styled: io_box
rect @client_request {
  spec {
    HTTP request entry point
    tag: api, v2
  }
  text @_text_0 "Client Request" {
    fill: #7C3AED  # purple
    font: "Inter" semibold 14
  }
  w: 200 h: 48
  use: io_box
  x: 300
  y: 40
}

# API Gateway
# [auto] styled: process_box
rect @api_gateway {
  spec "Rate limiting + request validation"
  text @_text_1 "API Gateway" {
    fill: #1D4ED8  # blue
    font: "Inter" medium 14
  }
  w: 200 h: 48
  use: process_box
  x: 300
  y: 140
}

# Auth check
# [auto] styled: decision_box
rect @auth_check {
  spec {
    JWT token validation
    todo: "reject expired tokens within 5s"
    status: done
  }
  text @_text_2 "Authenticate?" {
    fill: #92400E  # orange
    font: "Inter" semibold 14
  }
  w: 200 h: 48
  use: decision_box
  x: 300
  y: 240
}

# Auth failure
# [auto] styled: error_box
rect @auth_failure {
  text @_text_3 "401 Unauthorized" {
    fill: #DC2626  # red
    font: "Inter" medium 13
  }
  w: 160 h: 44
  use: error_box
  x: 600
  y: 240
}

# Route handler
# [auto] styled: process_box
rect @route_handler {
  spec "Match endpoint to controller"
  text @_text_4 "Route Handler" {
    fill: #1D4ED8  # blue
    font: "Inter" medium 14
  }
  w: 200 h: 48
  use: process_box
  x: 300
  y: 340
}

# Business logic
# [auto] styled: process_box
rect @business_logic {
  spec "Core domain logic execution"
  text @_text_5 "Business Logic" {
    fill: #1D4ED8  # blue
    font: "Inter" medium 14
  }
  w: 200 h: 48
  use: process_box
  x: 300
  y: 440
}

# DB query
# [auto] styled: process_box
rect @db_query {
  spec {
    Database read/write operations
    todo: "queries < 100ms p95"
    status: doing
  }
  text @_text_6 "Database Query" {
    fill: #1D4ED8  # blue
    font: "Inter" medium 14
  }
  w: 200 h: 48
  use: process_box
  x: 300
  y: 540
}

# Success response
# [auto] styled: success_box
rect @success_response {
  text @_text_7 "200 OK + JSON" {
    fill: #059669  # teal
    font: "Inter" semibold 14
  }
  w: 200 h: 48
  use: success_box
  x: 300
  y: 660
}

# Error response
# [auto] styled: error_box
rect @error_response {
  text @_text_8 "500 Server Error" {
    fill: #DC2626  # red
    font: "Inter" medium 13
  }
  w: 160 h: 44
  use: error_box
  x: 600
  y: 540
}

text @_auth_yes_label "valid token" {
}

text @_auth_no_label "invalid / expired" {
}

text @_db_success_label "query OK" {
}

text @_db_error_label "query failed" {
}

text @_auth_yes_label "valid token" {
}

text @_auth_no_label "invalid / expired" {
}

text @_db_success_label "query OK" {
}

text @_db_error_label "query failed" {
}

# ─── Flows ───

edge @req_to_gateway @client_request -> @api_gateway {
  stroke: #6B7280 2
  arrow: end
}
edge @gateway_to_auth @api_gateway -> @auth_check {
  stroke: #6B7280 2
  arrow: end
}
edge @auth_yes @auth_check -> @route_handler {
  text @_auth_yes_label "valid token" {}
  stroke: #10B981 2
  arrow: end
}
edge @auth_no @auth_check -> @auth_failure {
  text @_auth_no_label "invalid / expired" {}
  stroke: #EF4444 2
  arrow: end
}
edge @route_to_logic @route_handler -> @business_logic {
  stroke: #6B7280 2
  arrow: end
}
edge @logic_to_db @business_logic -> @db_query {
  stroke: #6B7280 2
  arrow: end
}
edge @db_success @db_query -> @success_response {
  text @_db_success_label "query OK" {}
  stroke: #10B981 2
  arrow: end
}
edge @db_error @db_query -> @error_response {
  text @_db_error_label "query failed" {}
  stroke: #EF4444 2
  arrow: end
}
