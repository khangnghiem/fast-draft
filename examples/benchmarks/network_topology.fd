# ─── Styles ───

style cache_box {
  fill: #D1FAE5  # green
  corner: 8
}

style db_box {
  fill: #FEF3C7  # yellow
  corner: 8
}

style ext_box {
  fill: #F3E8FF  # purple
  corner: 8
}

style server_box {
  fill: #EFF6FF  # blue
  corner: 8
}

# ─── Layout ───

# Load Balancer
# [auto] connects to api_server_1, api_server_2, api_server_3
rect @load_balancer {
  spec {
    Nginx reverse proxy — round-robin distribution
    todo: "health check every 10s"
    status: done
  }
  text @_text_9 "Load Balancer" {
    fill: #FFFFFF  # white
    font: "Inter" semibold 15
  }
  w: 200 h: 56
  fill: #8B5CF6  # blue
  corner: 10
  x: 320
  y: 20
}

# API servers
# [auto] styled: server_box
rect @api_server_1 {
  spec "Node.js v20 — handles /api/v2/*"
  text @_text_10 "API Server 1" {
    fill: #3B82F6  # blue
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: server_box
  x: 100
  y: 140
}

# [auto] styled: server_box
rect @api_server_2 {
  spec "Node.js v20 — handles /api/v2/*"
  text @_text_11 "API Server 2" {
    fill: #3B82F6  # blue
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: server_box
  x: 340
  y: 140
}

# [auto] styled: server_box
rect @api_server_3 {
  spec "Node.js v20 — handles /api/v2/*"
  text @_text_12 "API Server 3" {
    fill: #3B82F6  # blue
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: server_box
  x: 580
  y: 140
}

# Cache layer
# [auto] styled: cache_box
rect @redis_primary {
  spec {
    Redis 7 — session store + rate limit counters
    todo: "< 1ms p99 latency"
    status: done
  }
  text @_text_13 "Redis Primary" {
    fill: #22C55E  # green
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: cache_box
  x: 100
  y: 280
}

# [auto] styled: cache_box
rect @redis_replica {
  spec "Read replica — async replication lag < 50ms"
  text @_text_14 "Redis Replica" {
    fill: #22C55E  # green
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: cache_box
  x: 340
  y: 280
}

# Databases
# [auto] styled: db_box
rect @postgres_primary {
  spec {
    PostgreSQL 16 — primary read/write
    todo: "queries < 100ms p95"
    status: done
  }
  text @_text_15 "Postgres Primary" {
    fill: #F59E0B  # orange
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: db_box
  x: 100
  y: 420
}

# [auto] styled: db_box
rect @postgres_replica {
  spec "Streaming replica — async, 2s lag budget"
  text @_text_16 "Postgres Replica" {
    fill: #F59E0B  # orange
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: db_box
  x: 340
  y: 420
}

# External services
# [auto] styled: ext_box
rect @s3_storage {
  spec "AWS S3 — file uploads + static assets"
  text @_text_17 "S3 Storage" {
    fill: #8B5CF6  # blue
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: ext_box
  x: 580
  y: 280
}

# [auto] styled: ext_box
rect @queue {
  spec {
    RabbitMQ — async job processing
    todo: "message TTL 24h"
    status: doing
  }
  text @_text_18 "Message Queue" {
    fill: #8B5CF6  # blue
    font: "Inter" medium 14
  }
  w: 180 h: 48
  use: ext_box
  x: 580
  y: 420
}

# [auto] connects to s3_storage
rect @cdn {
  spec "CloudFront CDN — edge caching for static"
  text @_text_19 "CDN Edge" {
    fill: #FFFFFF  # white
    font: "Inter" semibold 15
  }
  w: 200 h: 56
  fill: #0F172A  # blue
  corner: 10
  x: 320
  y: 540
}

text @_lb_to_api1_label "round-robin" {
}

text @_lb_to_api3_label "round-robin" {
}

text @_api1_to_cache_label "session lookup" {
}

text @_api2_to_cache_label "read-through" {
}

text @_cache_replication_label "async repl" {
}

text @_api1_to_db_label "read/write" {
}

text @_api2_to_db_read_label "read-only" {
}

text @_db_replication_label "streaming repl" {
}

text @_api3_to_s3_label "file upload" {
}

text @_api3_to_queue_label "enqueue job" {
}

text @_cdn_to_s3_label "origin pull" {
}

text @_lb_to_api1_label "round-robin" {
}

text @_lb_to_api3_label "round-robin" {
}

text @_api1_to_cache_label "session lookup" {
}

text @_api2_to_cache_label "read-through" {
}

text @_cache_replication_label "async repl" {
}

text @_api1_to_db_label "read/write" {
}

text @_api2_to_db_read_label "read-only" {
}

text @_db_replication_label "streaming repl" {
}

text @_api3_to_s3_label "file upload" {
}

text @_api3_to_queue_label "enqueue job" {
}

text @_cdn_to_s3_label "origin pull" {
}

# ─── Flows ───

edge @lb_to_api1 @load_balancer -> @api_server_1 {
  text @_lb_to_api1_label "round-robin" {}
  stroke: #3B82F6 2
  arrow: end
  curve: smooth
}
edge @lb_to_api2 @load_balancer -> @api_server_2 {
  stroke: #3B82F6 2
  arrow: end
}
edge @lb_to_api3 @load_balancer -> @api_server_3 {
  text @_lb_to_api3_label "round-robin" {}
  stroke: #3B82F6 2
  arrow: end
  curve: smooth
}
edge @api1_to_cache @api_server_1 -> @redis_primary {
  text @_api1_to_cache_label "session lookup" {}
  stroke: #10B981 2
  arrow: end
}
edge @api2_to_cache @api_server_2 -> @redis_replica {
  text @_api2_to_cache_label "read-through" {}
  stroke: #10B981 2
  arrow: end
}
edge @cache_replication @redis_primary -> @redis_replica {
  text @_cache_replication_label "async repl" {}
  stroke: #10B981 1
  arrow: end
  curve: step
}
edge @api1_to_db @api_server_1 -> @postgres_primary {
  text @_api1_to_db_label "read/write" {}
  stroke: #F59E0B 2
  arrow: end
  curve: smooth
}
edge @api2_to_db_read @api_server_2 -> @postgres_replica {
  text @_api2_to_db_read_label "read-only" {}
  stroke: #F59E0B 1
  arrow: end
  curve: smooth
}
edge @db_replication @postgres_primary -> @postgres_replica {
  text @_db_replication_label "streaming repl" {}
  stroke: #F59E0B 1
  arrow: end
  curve: step
}
edge @api3_to_s3 @api_server_3 -> @s3_storage {
  text @_api3_to_s3_label "file upload" {}
  stroke: #8B5CF6 2
  arrow: end
}
edge @api3_to_queue @api_server_3 -> @queue {
  text @_api3_to_queue_label "enqueue job" {}
  stroke: #8B5CF6 2
  arrow: end
  curve: smooth
}
edge @cdn_to_s3 @cdn -> @s3_storage {
  text @_cdn_to_s3_label "origin pull" {}
  stroke: #64748B 1
  arrow: both
  curve: smooth
}
