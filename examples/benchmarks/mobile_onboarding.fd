style cta_primary {
  fill: #6C5CE7  # blue
  corner: 12
}

style dot_active {
  fill: #6C5CE7  # blue
  corner: 6
}

style dot_inactive {
  fill: #D1D5DB  # white
  corner: 6
}

style phone_frame {
  fill: #1A1A2E  # blue
  corner: 40
}

style screen_bg {
  fill: #FFFFFF  # white
  corner: 32
}

# Screen 1 — Welcome
# [auto] free container (1 children)
frame @screen_welcome {
  # [auto] container (5 children)
  group @welcome_content {
    rect @welcome_illustration {
      text @_text_51 "🎨" {
        fill: #6C5CE7  # blue
        font: "Inter" regular 64
      }
      w: 216 h: 180
      fill: #EDE9FE  # blue
      corner: 16
    }
    text @welcome_title "Design Anywhere" {
      fill: #1A1A2E  # blue
      font: "Inter" bold 22
    }
    text @welcome_desc "Create beautiful designs on the go with an intuitive canvas experience." {
      fill: #6B7280  # blue
      font: "Inter" regular 14
    }
    # [auto] container (3 children)
    group @dots_1 {
      # [auto] styled: dot_active
      rect @_rect_52 {
        w: 24 h: 6
        use: dot_active
      }
      # [auto] styled: dot_inactive
      rect @_rect_53 {
        w: 6 h: 6
        use: dot_inactive
      }
      # [auto] styled: dot_inactive
      rect @_rect_54 {
        w: 6 h: 6
        use: dot_inactive
      }
    }
    # [auto] styled: cta_primary
    rect @welcome_cta {
      text @_text_55 "Get Started" {
        fill: #FFFFFF  # white
        font: "Inter" semibold 15
      }
      w: 216 h: 48
      use: cta_primary
      when :hover {
        scale: 1.03
        ease: spring 200ms
      }
    }
    use: screen_bg
  }
  w: 280 h: 520
  clip: true
  use: phone_frame
  x: 60
  y: 60
}

# Screen 2 — Collaborate
# [auto] free container (1 children)
frame @screen_collab {
  # [auto] container (5 children)
  group @collab_content {
    rect @collab_illustration {
      text @_text_56 "👥" {
        fill: #3B82F6  # blue
        font: "Inter" regular 64
      }
      w: 216 h: 180
      fill: #DBEAFE  # blue
      corner: 16
    }
    text @collab_title "Work Together" {
      fill: #1A1A2E  # blue
      font: "Inter" bold 22
    }
    text @collab_desc "Share your canvas with teammates and iterate in real time." {
      fill: #6B7280  # blue
      font: "Inter" regular 14
    }
    # [auto] container (3 children)
    group @dots_2 {
      # [auto] styled: dot_inactive
      rect @_rect_57 {
        w: 6 h: 6
        use: dot_inactive
      }
      # [auto] styled: dot_active
      rect @_rect_58 {
        w: 24 h: 6
        use: dot_active
      }
      # [auto] styled: dot_inactive
      rect @_rect_59 {
        w: 6 h: 6
        use: dot_inactive
      }
    }
    # [auto] styled: cta_primary
    rect @collab_cta {
      text @_text_60 "Continue" {
        fill: #FFFFFF  # white
        font: "Inter" semibold 15
      }
      w: 216 h: 48
      use: cta_primary
    }
    use: screen_bg
  }
  w: 280 h: 520
  clip: true
  use: phone_frame
  x: 380
  y: 60
}

# Screen 3 — Export
# [auto] free container (1 children)
frame @screen_export {
  # [auto] container (5 children)
  group @export_content {
    rect @export_illustration {
      text @_text_61 "🚀" {
        fill: #10B981  # teal
        font: "Inter" regular 64
      }
      w: 216 h: 180
      fill: #D1FAE5  # green
      corner: 16
    }
    text @export_title "Ship It" {
      fill: #1A1A2E  # blue
      font: "Inter" bold 22
    }
    text @export_desc "Export to PNG, SVG, or generate production-ready code instantly." {
      fill: #6B7280  # blue
      font: "Inter" regular 14
    }
    # [auto] container (3 children)
    group @dots_3 {
      # [auto] styled: dot_inactive
      rect @_rect_62 {
        w: 6 h: 6
        use: dot_inactive
      }
      # [auto] styled: dot_inactive
      rect @_rect_63 {
        w: 6 h: 6
        use: dot_inactive
      }
      # [auto] styled: dot_active
      rect @_rect_64 {
        w: 24 h: 6
        use: dot_active
      }
    }
    rect @export_cta {
      text @_text_65 "Start Designing" {
        fill: #FFFFFF  # white
        font: "Inter" semibold 15
      }
      w: 216 h: 48
      fill: #10B981  # teal
      corner: 12
      when :hover {
        scale: 1.03
        ease: spring 200ms
      }
    }
    use: screen_bg
  }
  w: 280 h: 520
  clip: true
  use: phone_frame
  x: 700
  y: 60
}

