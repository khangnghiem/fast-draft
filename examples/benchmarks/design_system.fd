import "tokens.fd" as tokens

# ─── Styles ───

style body {
  fill: #6B7280  # blue
  font: "Inter" regular 16
}

style caption {
  fill: #6B7280  # blue
  font: "Inter" medium 12
}

style display {
  fill: #64748B  # blue
  font: "Inter" bold 48
}

style heading {
  fill: #64748B  # blue
  font: "Inter" semibold 24
}

style section_label {
  fill: #6B7280  # blue
  font: "Inter" semibold 11
  opacity: 0.6
}

style swatch_card {
  fill: #FFFFFF  # white
  corner: 12
}

# ─── Layout ───

# [auto] container (8 children)
group @design_system {
  text @page_title "Acme Design System" {
    use: display
  }
  text @page_subtitle "Tokens, Typography, Colors & Components" {
    use: body
  }
  text @colors_label "COLOR PALETTE" {
    use: section_label
  }
  # [auto] container (6 children)
  group @color_palette {
    # [auto] container (3 children)
    group @primary_swatch {
      rect @primary_block {
        w: 120 h: 80
        fill: #8B5CF6  # blue
        corner: 8
      }
      text @_text_17 "Purple" {
        fill: #64748B  # blue
        font: "Inter" medium 14
      }
      text @_text_18 "#6C5CE7" {
        use: caption
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
    # [auto] container (3 children)
    group @secondary_swatch {
      rect @secondary_block {
        w: 120 h: 80
        fill: #3B82F6  # blue
        corner: 8
      }
      text @_text_19 "Blue" {
        fill: #64748B  # blue
        font: "Inter" medium 14
      }
      text @_text_20 "#3B82F6" {
        use: caption
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
    # [auto] container (3 children)
    group @success_swatch {
      rect @success_block {
        w: 120 h: 80
        fill: #22C55E  # green
        corner: 8
      }
      text @_text_21 "Green" {
        fill: #64748B  # blue
        font: "Inter" medium 14
      }
      text @_text_22 "#10B981" {
        use: caption
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
    # [auto] container (3 children)
    group @warning_swatch {
      rect @warning_block {
        w: 120 h: 80
        fill: #F59E0B  # orange
        corner: 8
      }
      text @_text_23 "Amber" {
        fill: #64748B  # blue
        font: "Inter" medium 14
      }
      text @_text_24 "#F59E0B" {
        use: caption
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
    # [auto] container (3 children)
    group @danger_swatch {
      rect @danger_block {
        w: 120 h: 80
        fill: #EF4444  # red
        corner: 8
      }
      text @_text_25 "Red" {
        fill: #64748B  # blue
        font: "Inter" medium 14
      }
      text @_text_26 "#EF4444" {
        use: caption
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
    # [auto] container (3 children)
    group @neutral_swatch {
      rect @neutral_block {
        w: 120 h: 80
        fill: #64748B  # blue
        corner: 8
      }
      text @_text_27 "Slate" {
        fill: #64748B  # blue
        font: "Inter" medium 14
      }
      text @_text_28 "#334155" {
        use: caption
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
  }
  text @type_label "TYPOGRAPHY" {
    use: section_label
  }
  # [auto] container (4 children)
  group @typography_showcase {
    text @_text_29 "Display — 48px Bold" {
      use: display
    }
    text @_text_30 "Heading — 24px Semibold" {
      use: heading
    }
    text @_text_31 "Body — 16px Regular" {
      use: body
    }
    text @_text_32 "Caption — 12px Medium" {
      use: caption
    }
    use: swatch_card
    shadow: (0,2,8,#0000000F)
  }
  text @comp_label "COMPONENTS" {
    use: section_label
  }
  # [auto] container (3 children)
  group @component_examples {
    # [auto] container (5 children)
    group @buttons {
      text @_text_33 "Buttons" {
        use: heading
      }
      rect @btn_primary {
        text @_text_34 "Primary Action" {
          fill: #FFFFFF  # white
          font: "Inter" semibold 14
        }
        w: 200 h: 44
        fill: #8B5CF6  # blue
        corner: 10
        when :hover {
          fill: #5A4BD1  # blue
          scale: 1.02
          ease: spring 200ms
        }
      }
      rect @btn_secondary {
        text @_text_35 "Secondary" {
          fill: #64748B  # blue
          font: "Inter" medium 14
        }
        w: 200 h: 44
        fill: #F3F4F6  # white
        corner: 10
        when :hover {
          fill: #E5E7EB  # white
          ease: ease_out 150ms
        }
      }
      rect @btn_outline {
        text @_text_36 "Outlined" {
          fill: #64748B  # blue
          font: "Inter" medium 14
        }
        w: 200 h: 44
        fill: #FFFFFF  # white
        stroke: #D1D5DB 1
        corner: 10
      }
      rect @btn_ghost {
        text @_text_37 "Ghost" {
          fill: #8B5CF6  # blue
          font: "Inter" medium 14
        }
        w: 200 h: 44
        fill: #00000000  # black
        corner: 10
        opacity: 0.8
        when :hover {
          opacity: 1
          ease: ease_out 100ms
        }
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
    # [auto] container (4 children)
    group @inputs {
      text @_text_38 "Inputs" {
        use: heading
      }
      rect @input_default {
        text @_text_39 "Default input..." {
          fill: #6B7280  # blue
          font: "Inter" regular 14
          opacity: 0.5
        }
        w: 260 h: 44
        fill: #FFFFFF  # white
        stroke: #D1D5DB 1
        corner: 8
      }
      rect @input_focused {
        text @_text_40 "Focused input" {
          fill: #64748B  # blue
          font: "Inter" regular 14
        }
        w: 260 h: 44
        fill: #FFFFFF  # white
        stroke: #6C5CE7 2
        corner: 8
      }
      rect @input_error {
        text @_text_41 "Error state" {
          fill: #EF4444  # red
          font: "Inter" regular 14
        }
        w: 260 h: 44
        fill: #FEF2F2  # white
        stroke: #EF4444 1
        corner: 8
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
    # [auto] container (2 children)
    group @badges {
      text @_text_42 "Badges" {
        use: heading
      }
      # [auto] container (4 children)
      group @badge_row {
        rect @_rect_43 {
          text @_text_44 "Info" {
            fill: #3B82F6  # blue
            font: "Inter" medium 11
          }
          w: 72 h: 24
          fill: #DBEAFE  # blue
          corner: 12
        }
        rect @_rect_45 {
          text @_text_46 "Success" {
            fill: #22C55E  # green
            font: "Inter" medium 11
          }
          w: 80 h: 24
          fill: #D1FAE5  # green
          corner: 12
        }
        rect @_rect_47 {
          text @_text_48 "Warning" {
            fill: #F59E0B  # orange
            font: "Inter" medium 11
          }
          w: 80 h: 24
          fill: #FEF3C7  # yellow
          corner: 12
        }
        rect @_rect_49 {
          text @_text_50 "Error" {
            fill: #EF4444  # red
            font: "Inter" medium 11
          }
          w: 64 h: 24
          fill: #FEE2E2  # red
          corner: 12
        }
      }
      use: swatch_card
      shadow: (0,2,8,#0000000F)
    }
  }
  fill: #F8FAFC  # white
  corner: 20
  center_in: canvas
}

