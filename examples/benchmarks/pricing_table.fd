style feature_text {
  fill: #4B5563  # blue
  font: "Inter" regular 14
}

style price_text {
  fill: #111827  # blue
  font: "Inter" bold 40
}

style tier_card {
  fill: #FFFFFF  # white
  corner: 16
}

style tier_highlighted {
  fill: #6C5CE7  # blue
  corner: 16
}

style tier_name {
  fill: #111827  # blue
  font: "Inter" semibold 20
}

# [auto] container (2 children)
group @pricing_section {
  # [auto] container (2 children)
  group @pricing_header {
    text @pricing_title "Simple, Transparent Pricing" {
      fill: #111827  # blue
      font: "Inter" bold 32
    }
    text @pricing_subtitle "No hidden fees. Cancel anytime." {
      fill: #6B7280  # blue
      font: "Inter" regular 16
    }
  }
  # [auto] container (3 children)
  group @pricing_tiers {
    # [auto] container (8 children)
    group @free_tier {
      text @free_name "Free" {
        use: tier_name
      }
      # [auto] container (2 children)
      group @free_price {
        text @_text_66 "$0" {
          use: price_text
        }
        text @_text_67 "/month" {
          fill: #9CA3AF  # blue
          font: "Inter" regular 14
        }
      }
      rect @free_divider {
        w: 244 h: 1
        fill: #E5E7EB  # white
      }
      text @_text_68 "5 projects" {
        use: feature_text
      }
      text @_text_69 "1 GB storage" {
        use: feature_text
      }
      text @_text_70 "Basic export (PNG)" {
        use: feature_text
      }
      text @_text_71 "Community support" {
        use: feature_text
      }
      rect @free_cta {
        text @_text_72 "Get Started" {
          fill: #374151  # blue
          font: "Inter" semibold 14
        }
        w: 244 h: 44
        fill: #F3F4F6  # white
        corner: 10
        when :hover {
          fill: #E5E7EB  # white
          ease: ease_out 150ms
        }
      }
      use: tier_card
      shadow: (0,2,12,#00000012)
    }
    # [auto] container (10 children)
    group @pro_tier {
      rect @pro_badge {
        text @_text_73 "Popular" {
          fill: #FFFFFF  # white
          font: "Inter" semibold 11
        }
        w: 80 h: 24
        fill: #FFFFFF33  # white
        corner: 12
      }
      text @pro_name "Pro" {
        fill: #FFFFFF  # white
        font: "Inter" semibold 20
      }
      # [auto] container (2 children)
      group @pro_price {
        text @_text_74 "$19" {
          fill: #FFFFFF  # white
          font: "Inter" bold 40
        }
        text @_text_75 "/month" {
          fill: #FFFFFFB3  # white
          font: "Inter" regular 14
        }
      }
      rect @pro_divider {
        w: 244 h: 1
        fill: #FFFFFF33  # white
      }
      text @_text_76 "Unlimited projects" {
        fill: #FFFFFFCC  # white
        font: "Inter" regular 14
      }
      text @_text_77 "50 GB storage" {
        fill: #FFFFFFCC  # white
        font: "Inter" regular 14
      }
      text @_text_78 "SVG + PDF export" {
        fill: #FFFFFFCC  # white
        font: "Inter" regular 14
      }
      text @_text_79 "Priority support" {
        fill: #FFFFFFCC  # white
        font: "Inter" regular 14
      }
      text @_text_80 "Version history" {
        fill: #FFFFFFCC  # white
        font: "Inter" regular 14
      }
      rect @pro_cta {
        text @_text_81 "Upgrade to Pro" {
          fill: #6C5CE7  # blue
          font: "Inter" semibold 14
        }
        w: 244 h: 44
        fill: #FFFFFF  # white
        corner: 10
        when :hover {
          scale: 1.03
          ease: spring 200ms
        }
      }
      use: tier_highlighted
      shadow: (0,8,32,#6C5CE740)
    }
    # [auto] container (10 children)
    group @enterprise_tier {
      text @enterprise_name "Enterprise" {
        use: tier_name
      }
      # [auto] container (2 children)
      group @enterprise_price {
        text @_text_82 "$79" {
          use: price_text
        }
        text @_text_83 "/month" {
          fill: #9CA3AF  # blue
          font: "Inter" regular 14
        }
      }
      rect @ent_divider {
        w: 244 h: 1
        fill: #E5E7EB  # white
      }
      text @_text_84 "Everything in Pro" {
        use: feature_text
      }
      text @_text_85 "Unlimited storage" {
        use: feature_text
      }
      text @_text_86 "SSO & SAML" {
        use: feature_text
      }
      text @_text_87 "Custom branding" {
        use: feature_text
      }
      text @_text_88 "Dedicated support" {
        use: feature_text
      }
      text @_text_89 "SLA guarantee" {
        use: feature_text
      }
      rect @enterprise_cta {
        text @_text_90 "Contact Sales" {
          fill: #FFFFFF  # white
          font: "Inter" semibold 14
        }
        w: 244 h: 44
        fill: #111827  # blue
        corner: 10
        when :hover {
          fill: #1F2937  # blue
          ease: ease_out 150ms
        }
      }
      use: tier_card
      shadow: (0,2,12,#00000012)
    }
  }
  center_in: canvas
}

