style card_bg {
  fill: #FFFFFF  # white
  corner: 16
}

style input_field {
  fill: #F8F9FA  # white
  corner: 8
}

style primary_btn {
  fill: #6C5CE7  # blue
  corner: 10
}

style secondary_btn {
  fill: #F0F0F5  # white
  corner: 10
}

# [auto] container (9 children)
group @login_form {
  text @title "Sign In" {
    fill: #1A1A2E  # blue
    font: "Inter" bold 28
  }
  text @subtitle "Welcome back! Please enter your details." {
    fill: #6B7280  # blue
    font: "Inter" regular 14
  }
  # [auto] container (2 children)
  group @email_group {
    text @email_label "Email" {
      fill: #374151  # blue
      font: "Inter" medium 13
    }
    # [auto] styled: input_field
    rect @email_input {
      text @email_placeholder "enter@example.com" {
        fill: #9CA3AF  # blue
        font: "Inter" regular 14
      }
      w: 336 h: 44
      use: input_field
      stroke: #E5E7EB 1
    }
  }
  # [auto] container (2 children)
  group @password_group {
    text @password_label "Password" {
      fill: #374151  # blue
      font: "Inter" medium 13
    }
    # [auto] styled: input_field
    rect @password_input {
      text @password_placeholder "••••••••" {
        fill: #9CA3AF  # blue
        font: "Inter" regular 14
      }
      w: 336 h: 44
      use: input_field
      stroke: #E5E7EB 1
    }
  }
  text @forgot_link "Forgot password?" {
    fill: #6C5CE7  # blue
    font: "Inter" medium 13
  }
  # [auto] styled: primary_btn
  rect @sign_in_btn {
    spec {
      Primary CTA — triggers authentication flow
      todo: "disabled when fields empty"
      status: done
    }
    text @sign_in_label "Sign In" {
      fill: #FFFFFF  # white
      font: "Inter" semibold 15
    }
    w: 336 h: 48
    use: primary_btn
    when :hover {
      fill: #5A4BD1  # blue
      scale: 1.02
      ease: spring 200ms
    }
  }
  rect @divider {
    w: 336 h: 1
    fill: #E5E7EB  # white
  }
  # [auto] styled: secondary_btn
  rect @google_btn {
    text @google_label "Continue with Google" {
      fill: #374151  # blue
      font: "Inter" medium 14
    }
    w: 336 h: 44
    use: secondary_btn
    stroke: #E5E7EB 1
    when :hover {
      fill: #E8E8ED  # white
      ease: ease_out 150ms
    }
  }
  text @signup_prompt "Don't have an account? Sign up" {
    fill: #6B7280  # blue
    font: "Inter" regular 13
  }
  use: card_bg
  shadow: (0,4,24,#00000018)
  center_in: canvas
}

