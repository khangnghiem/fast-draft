# FD v1
# Constraint-based layout — demonstrates all positioning strategies
# ─── Canvas-centered hero ────────────────────────────────────────────────
frame @hero {
  spec "Hero section — demonstrates center_in constraint"
  text @hero_sub "The token-efficient design format" {
    fill: #6B7280  # blue
    font: "Inter" regular 18
  }
  rect @hero_cta {
    w: 200 h: 52
    fill: #6C5CE7  # blue
    corner: 12
    when :hover {
      fill: #5A4BD1  # blue
      scale: 1.04
      ease: spring 250ms
    }
  }
  layout: column gap=16 pad=40
  w: 407.93 h: 187.77
  x: 157.7
  y: 678.67
}

text @_text_0 "Try It Now" {
  fill: #FFFFFF  # white
  font: "Inter" semibold 16
  x: 249.51
  y: 785.35
}

text @hero_title "Welcome to FD" {
  fill: #1A1A2E  # blue
  font: "Inter" extrabold 48
  x: 306.81
  y: 449.41
}

# ─── Offset-positioned tooltip ───────────────────────────────────────────
rect @tooltip_target {
  spec "Anchor element for tooltip"
  text @_text_1 "Hover me" {
    fill: #333333  # gray
    font: "Inter" medium 14
  }
  w: 160 h: 48
  fill: #F5F5F7  # white
  stroke: #E8E8EC 1
  corner: 8
}

rect @tooltip {
  spec "Tooltip — positioned via offset constraint"
  text @_text_2 "I'm 20px right, 60px down" {
    fill: #FFFFFF  # white
    font: "Inter" regular 13
  }
  w: 200 h: 44
  fill: #1A1A2E  # blue
  corner: 8
  x: 154.92
  y: 969.79
  when :enter {
    opacity: 1
    ease: ease_out 300ms
  }
}

# ─── Fill-parent panel ───────────────────────────────────────────────────
rect @full_width_bg {
  spec "Background that fills parent width with 24px padding"
  w: 800 h: 120
  fill: #F8F9FA  # white
  corner: 0
  x: 24.37
  y: 34.27
}

text @_text_3 "This panel uses fill_parent with 24px inset" {
  fill: #6B7280  # blue
  font: "Inter" regular 14
  x: 183.66
  y: 326.51
}

# ─── Floating action button ─────────────────────────────────────────────
rect @fab {
  spec {
    "Floating action button — fixed bottom-right"
    accept: "persists across scroll"
  }
  text @_text_4 "+" {
    fill: #FFFFFF  # white
    font: "Inter" bold 24
    x: 20.19
    y: 10.73
  }
  w: 56 h: 56
  fill: #6C5CE7  # blue
  corner: 28
  shadow: (0,4,16,#6C5CE760)
  x: 145.14
  y: 1111.11
  when :hover {
    scale: 1.1
    ease: spring 300ms
  }
  when :press {
    scale: 0.9
    ease: spring 150ms
  }
}

@tooltip_target -> offset: @hero 0, 180
