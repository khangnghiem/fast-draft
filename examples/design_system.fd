}

# ─── Constraints ───

@color_palette -> center_in: canvas

# ─── Flows ───

edge @edge_1 {
  from: @ellipse_3
  to: @_rect_0
  stroke: #6B7080 1.5
  arrow: end
  curve: smooth
}
