# ─── Styles ───

style default_text {
  fill: #374151  # blue
  font: "Inter" medium 14
}

style hover_glow {
}

# ─── Layout ───

# [auto] container (2 children)
group @board {
  spec {
    A freehand drawing board section
    todo: "Allows pen strokes"
  }
  # [auto] styled: hover_glow
  path @scribble {
    spec "User signature or doodle"
    use: hover_glow
    stroke: #3B82F6 3
  }
  path @highlight {
    stroke: #FBBF24 8
    opacity: 0.6
  }
}

# The user can connect drawn elements to standard shapes
rect @note {
  text @_text_16 "Sign here" {
    use: default_text
  }
  w: 120 h: 80
  fill: #FEF3C7  # yellow
}

# ─── Flows ───

edge @doodle_link @scribble -> @note {
  stroke: #9CA3AF 2
  arrow: end
  curve: smooth
  flow: pulse 1500ms
}
