# ─── Path drawing and connections ───

# Since FD paths record points directly, they are fully defined visually.
# This example illustrates how to attach styles, animations and references
# to paths in a drawing board setting.

style hover_glow {
  stroke: #60A5FA 4.0
}

style default_text {
  font: "Inter" medium 14
  fill: #374151
}

group @board {
  spec {
    "A freehand drawing board section"
    todo: "Allows pen strokes"
  }

  # A standalone freehand path representing a doodle or signature
  path @scribble {
    stroke: #3B82F6 3.0
    use: hover_glow
    spec {
      "User signature or doodle"
    }
  }

  path @highlight {
    stroke: #FBBF24 8.0
    opacity: 0.6
  }
}

# The user can connect drawn elements to standard shapes
rect @note {
  w: 120 h: 80
  fill: #FEF3C7
  text "Sign here" {
    use: default_text
  }
}

edge @doodle_link {
  from: @scribble
  to: @note
  arrow: end
  curve: smooth
  stroke: #9CA3AF 2.0
  flow: pulse 1500ms
}
