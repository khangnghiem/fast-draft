style accent {
  fill: #6C5CE7  # blue
}

style label_style {
  fill: #2D3436  # gray
  font: "Inter" medium 14
}

style soft {
  fill: #DFE6E9  # white
  corner: 12
}

# ── Title ──
text @welcome_title "Welcome to Fast Draft ✨" {
  fill: #2D3436  # gray
  font: "Inter" bold 28
  x: 180
  y: 40
}

text @welcome_sub "Click, move, and edit these shapes to learn the basics" {
  fill: #636E72  # cyan
  font: "Inter" regular 14
  x: 180
  y: 80
}

# ── Step 1: Shapes ──
# [auto] styled: soft
rect @step1_bg {
  w: 200 h: 140
  use: soft
  x: 60
  y: 140
}

text @step1_title "1. Draw Shapes" {
  use: label_style
  x: 80
  y: 160
}

text @step1_desc "Press R for rectangles\nPress O for ellipses\nPress F for frames" {
  fill: #636E72  # cyan
  font: "Inter" regular 12
  x: 80
  y: 190
}

# [auto] styled: accent
rect @step1_demo {
  w: 30 h: 30
  use: accent
  corner: 6
  x: 220
  y: 200
  when :hover {
    scale: 1.1
    ease: spring 200ms
  }
}

# ── Step 2: Text ──
# [auto] styled: soft
rect @step2_bg {
  w: 200 h: 140
  use: soft
  x: 300
  y: 140
}

text @step2_title "2. Add Text" {
  use: label_style
  x: 320
  y: 160
}

text @step2_desc "Press T for text tool\nDouble-click to edit\nTry changing this!" {
  fill: #636E72  # cyan
  font: "Inter" regular 12
  x: 320
  y: 190
}

# ── Step 3: Styles ──
# [auto] styled: soft
rect @step3_bg {
  w: 200 h: 140
  use: soft
  x: 540
  y: 140
}

text @step3_title "3. Style It" {
  use: label_style
  x: 560
  y: 160
}

text @step3_desc "Select a shape\nUse the floating bar\nto change fill & stroke" {
  fill: #636E72  # cyan
  font: "Inter" regular 12
  x: 560
  y: 190
}

ellipse @step3_demo {
  w: 20 h: 20
  fill: #E17055  # red
  x: 700
  y: 200
  when :hover {
    fill: #00B894  # teal
    ease: ease_out 300ms
  }
}

# ── Interactive Demo Area ──
text @playground_label "Playground — try drawing below!" {
  fill: #2D3436  # gray
  font: "Inter" semibold 16
  x: 180
  y: 330
}

rect @playground {
  w: 680 h: 240
  fill: #FAFAFA  # white
  stroke: #DFE6E9 2
  corner: 16
  x: 60
  y: 360
}

# ── Shortcut Hint ──
text @shortcut_hint "Press ? for all keyboard shortcuts" {
  fill: #B2BEC3  # cyan
  font: "Inter" regular 12
  x: 260
  y: 640
}

