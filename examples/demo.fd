# ─── Styles ───

style accent_text {
  fill: #FFFFFF  # white
  font: "Inter" semibold 14
}

style body {
  fill: #6B7280  # blue
  font: "Inter" regular 14
}

style brand {
  fill: #6C5CE7  # blue
  corner: 12
}

style card {
  fill: #FFFFFF  # white
  corner: 14
}

style heading {
  fill: #1A1A2E  # blue
  font: "Inter" bold 22
}

style metric {
  fill: #6C5CE7  # blue
  font: "Inter" bold 32
}

style subheading {
  fill: #111827  # blue
  font: "Inter" semibold 16
}

edge_defaults {
  stroke: #8B7CF7 1.5
  arrow: end
  curve: smooth
}

# ─── Layout ───

# Sidebar navigation
# [auto] free container (4 children)
frame @sidebar {
  spec {
    "Persistent sidebar — always visible"
    accept: "collapses to icons on small screens"
    status: done
    priority: high
    tag: navigation, responsive
  }
  # [auto] label: "FastDraft"
  text @app_name "FastDraft" {
    fill: #FFFFFF  # white
    font: "Inter" bold 18
  }
  rect @nav_dashboard {
    # [auto] label: "Dashboard"
    text @_text_10 "Dashboard" {
      use: accent_text
    }
    w: 180 h: 40
    fill: #5A4BD1  # blue
    corner: 8
    when :hover {
      fill: #4A3BC1  # blue
      ease: ease_out 150ms
    }
  }
  rect @nav_projects {
    # [auto] label: "Projects"
    text @_text_11 "Projects" {
      use: accent_text
      opacity: 0.7
    }
    w: 180 h: 40
    corner: 8
    when :hover {
      fill: #5A4BD1  # blue
      ease: ease_out 150ms
    }
  }
  rect @nav_settings {
    # [auto] label: "Settings"
    text @_text_12 "Settings" {
      use: accent_text
      opacity: 0.7
    }
    w: 180 h: 40
    corner: 8
    when :hover {
      fill: #5A4BD1  # blue
      ease: ease_out 150ms
    }
  }
  layout: column gap=8 pad=16
  w: 220 h: 600
  fill: #2D2B55  # blue
  corner: 0
  x: 20
  y: 20
}

# Top header area
# [auto] label: "Dashboard"
text @page_title "Dashboard" {
  use: heading
  x: 280
  y: 32
}

# [auto] label: "Welcome back — here's wha…"
text @page_subtitle "Welcome back — here's what's happening today." {
  use: body
  x: 280
  y: 60
}

# ─── Metric Cards ───
# [auto] styled: card
rect @card_revenue {
  spec {
    "Revenue metric card"
    accept: "shows daily/weekly/monthly toggle"
    accept: "sparkline chart in background"
    status: doing
    priority: high
    tag: metrics, dashboard
  }
  # [auto] label: "+12.5% ↑"
  text @revenue_delta "+12.5% ↑" {
    fill: #22C55E  # green
    font: "Inter" semibold 13
    x: 424
    y: 143
  }
  w: 220 h: 120
  use: card
  shadow: (0,2,16,#00000010)
  x: 280
  y: 100
  when :hover {
    scale: 1
    ease: spring 200ms
  }
}

# [auto] label: "Revenue"
text @revenue_label "Revenue" {
  use: body
  x: 490.7
  y: 183.7
}

# [auto] label: "$48,250"
text @revenue_value "$48,250" {
  use: metric
  x: 594.9
  y: 203.6
}

# [auto] styled: card
rect @card_users {
  # [auto] label: "Active Users"
  text @users_label "Active Users" {
    use: body
    x: 520
    y: 112
  }
  w: 220 h: 120
  use: card
  shadow: (0,2,16,#00000010)
  x: 518.7
  y: 98.8
  when :hover {
    scale: 1
    ease: spring 200ms
  }
}

# [auto] label: "2,847"
text @users_value "2,847" {
  use: metric
  x: 1041.6
  y: 235.9
}

# [auto] styled: card
rect @card_tasks {
  # [auto] label: "Completed Tasks"
  text @tasks_label "Completed Tasks" {
    use: body
    x: 756
    y: 112
  }
  # [auto] label: "1,094"
  text @tasks_value "1,094" {
    use: metric
    x: 756
    y: 136
  }
  w: 220 h: 120
  use: card
  shadow: (0,2,16,#00000010)
  x: 755
  y: 98.8
  when :hover {
    scale: 1
    ease: spring 200ms
  }
}

# ─── Activity Feed ───
# [auto] column container (4 children)
frame @activity_feed {
  spec {
    "Recent activity stream"
    accept: "auto-refreshes every 30s"
    accept: "click to navigate to item"
    status: todo
    tag: realtime, engagement
  }
  # [auto] label: "Recent Activity"
  text @feed_title "Recent Activity" {
    use: subheading
    x: 8.4
    y: 5.8
  }
  rect @activity_1 {
    # [auto] label: "Alice submitted design review"
    text @_text_13 "Alice submitted design review" {
      use: body
    }
    w: 420 h: 44
    fill: #F9FAFB  # white
    corner: 8
  }
  rect @activity_2 {
    # [auto] label: "Bob merged pull request #284"
    text @_text_14 "Bob merged pull request #284" {
      use: body
    }
    w: 420 h: 44
    fill: #F9FAFB  # white
    corner: 8
  }
  rect @activity_3 {
    # [auto] label: "Carol deployed v2.1.0 to st…"
    text @_text_15 "Carol deployed v2.1.0 to staging" {
      use: body
    }
    w: 420 h: 44
    fill: #F9FAFB  # white
    corner: 8
  }
  layout: column gap=8 pad=20
  w: 460 h: 280
  use: card
  shadow: (0,2,16,#00000010)
  x: 278
  y: 308.8
}

# ─── Pipeline Status ───
# [auto] column container (1 children)
frame @pipeline {
  # [auto] label: "Deployment Pipeline"
  text @pipeline_title "Deployment Pipeline" {
    use: subheading
  }
  layout: column gap=12 pad=20
  w: 460 h: 236
  use: card
  shadow: (0,2,16,#00000010)
  x: 280
  y: 540
}

# Pipeline stages as connected nodes
# [auto] connects to stage_test
rect @stage_build {
  # [auto] label: "Test"
  text @_text_23 "Test" {
  }
  w: 90 h: 44
  fill: #22C55E  # green
  corner: 8
  x: 166.3
  y: 637.5
}

# [auto] label: "Build"
text @_text_16 "Build" {
  use: accent_text
  x: 236.6
  y: 655
}

# [auto] connects to stage_staging
rect @stage_test {
  # [auto] label: "Test"
  text @_text_17 "Test" {
    use: accent_text
  }
  w: 90 h: 44
  fill: #22C55E  # green
  corner: 8
  x: 428
  y: 640
}

# [auto] connects to stage_prod
rect @stage_staging {
  # [auto] label: "Staging"
  text @_text_18 "Staging" {
    use: accent_text
  }
  w: 90 h: 44
  fill: #F59E0B  # orange
  corner: 8
  x: 548
  y: 640
  when :hover {
    fill: #D97706  # orange
    ease: ease_out 150ms
  }
}

ellipse @stage_prod {
  # [auto] label: "Prod"
  text @_text_19 "Prod" {
    use: accent_text
  }
  w: 90 h: 44
  fill: #6B7280  # blue
  corner: 8
  x: 668
  y: 640
  when :press {
    fill: #6C5CE7  # blue
    ease: spring 300ms
  }
}

# ─── Flows ───

edge @build_to_test {
  from: @stage_build
  to: @stage_test
  stroke: #6B7080 1.5
  flow: pulse 800ms
}
edge @test_to_staging {
  from: @stage_test
  to: @stage_staging
  stroke: #6B7080 1.5
  flow: pulse 800ms
}
edge @staging_to_prod {
  from: @stage_staging
  to: @stage_prod
  stroke: #F59E0B 1.5
  flow: dash 1200ms
}
edge @revenue_to_users {
  from: @card_revenue
  to: @card_users
  stroke: #E5E7EB 1
}
edge @users_to_tasks {
  from: @card_users
  to: @card_tasks
  stroke: #E5E7EB 1
}
