style label {
  fill: #333333  # gray
  font: "Inter" regular 14
}

style muted {
  fill: #999999  # gray
  font: "Inter" regular 12
}

# ─── Checkout page ───────────────────────────────────────────────────────
# [auto] column container (5 children)
frame @checkout_page {
  spec {
    Checkout flow — 3-step wizard
    todo: "cart review → shipping → payment"
    todo: "back button returns to previous step"
    todo: "progress indicator shows current step"
    status: doing
    priority: high
    tag: checkout, mvp, revenue
  }
  # [auto] row container (3 children)
  frame @progress {
    spec {
      Step indicator — 3 steps
      todo: "completed steps are highlighted"
      todo: "current step shows active color"
      status: todo
    }
    rect @step_1 {
      spec "Step 1: Cart — completed"
      w: 140 h: 4
      fill: #6C5CE7  # blue
      corner: 2
    }
    rect @step_2 {
      spec "Step 2: Shipping — active"
      w: 140 h: 4
      fill: #6C5CE7  # blue
      corner: 2
    }
    rect @step_3 {
      spec "Step 3: Payment — pending"
      w: 140 h: 4
      fill: #E8E8EC  # white
      corner: 2
    }
    layout: row gap=0 pad=0
    w: 420 h: 4
  }
  text @page_heading "Shipping Details" {
    fill: #1A1A2E  # blue
    font: "Inter" bold 24
  }
  # [auto] column container (4 children)
  frame @form {
    spec {
      Shipping address form
      todo: "autofill from saved addresses"
      todo: "address validation via Google Maps API"
      todo: "international address format support"
      priority: high
      tag: form, ux
    }
    # [auto] row container (2 children)
    frame @name_row {
      rect @first_name {
        spec {
          First name — required
          todo: "min 2 characters"
        }
        text @_text_0 "First name" {
          use: muted
        }
        w: 200 h: 48
        stroke: #E8E8EC 1
        corner: 8
      }
      rect @last_name {
        spec {
          Last name — required
          todo: "min 2 characters"
        }
        text @_text_1 "Last name" {
          use: muted
        }
        w: 200 h: 48
        stroke: #E8E8EC 1
        corner: 8
      }
      layout: row gap=12 pad=0
      w: 412 h: 48
    }
    rect @address_1 {
      spec {
        Street address — required
        todo: "autocomplete suggestions on typing"
        priority: high
      }
      text @_text_2 "Street address" {
        use: muted
      }
      w: 412 h: 48
      stroke: #E8E8EC 1
      corner: 8
    }
    rect @address_2 {
      spec "Apt/Suite — optional"
      text @_text_3 "Apt, suite, etc. (optional)" {
        use: muted
      }
      w: 412 h: 48
      stroke: #E8E8EC 1
      corner: 8
    }
    # [auto] row container (3 children)
    frame @city_state {
      rect @city {
        spec "City — required"
        text @_text_4 "City" {
          use: muted
        }
        w: 200 h: 48
        stroke: #E8E8EC 1
        corner: 8
      }
      rect @state {
        spec {
          State — dropdown
          todo: "shows state list for US addresses"
        }
        text @_text_5 "State" {
          use: muted
        }
        w: 96 h: 48
        stroke: #E8E8EC 1
        corner: 8
      }
      rect @zip {
        spec {
          ZIP — required
          todo: "validates format per country"
        }
        text @_text_6 "ZIP" {
          use: muted
        }
        w: 96 h: 48
        stroke: #E8E8EC 1
        corner: 8
      }
      layout: row gap=12 pad=0
      w: 412 h: 48
    }
    layout: column gap=12 pad=0
    w: 412 h: 400
  }
  rect @order_summary {
    spec {
      Collapsible order summary panel
      todo: "shows item thumbnails, quantities, prices"
      todo: "updates total on coupon apply"
      priority: medium
      tag: checkout
    }
    # [auto] column container (5 children)
    frame @_summary_layout {
      text @_text_7 "Order Summary" {
        fill: #1A1A2E  # blue
        font: "Inter" semibold 16
      }
      text @_text_8 "Widget Pro × 2" {
        use: label
      }
      text @_text_9 "Cable Pack × 1" {
        use: label
      }
      rect @divider {
        w: 372 h: 1
        fill: #E8E8EC  # white
      }
      text @_text_10 "Total: $147.00" {
        fill: #1A1A2E  # blue
        font: "Inter" bold 18
      }
      layout: column gap=8 pad=20
      w: 372 h: 160
    }
    w: 412 h: 200
    fill: #F8F9FA  # white
    stroke: #E8E8EC 1
    corner: 12
  }
  # [auto] row container (2 children)
  frame @actions {
    rect @btn_back {
      spec "Back to cart"
      text @_text_11 "Back" {
        fill: #333333  # gray
        font: "Inter" medium 15
      }
      w: 120 h: 48
      stroke: #E8E8EC 1
      corner: 10
      when :hover {
        fill: #F5F5F7  # white
        ease: ease_out 150ms
      }
    }
    rect @btn_continue {
      spec {
        Continue to payment
        todo: "validates all fields before proceeding"
        todo: "disabled when required fields incomplete"
        priority: high
      }
      text @_text_12 "Continue to Payment" {
        fill: #FFFFFF  # white
        font: "Inter" semibold 15
      }
      w: 280 h: 48
      fill: #6C5CE7  # blue
      corner: 10
      when :hover {
        fill: #5A4BD1  # blue
        scale: 1.02
        ease: spring 200ms
      }
      when :press {
        scale: 0.97
        ease: ease_out 100ms
      }
    }
    layout: row gap=12 pad=0
    w: 412 h: 48
  }
  layout: column gap=20 pad=32
  w: 500 h: 800
  center_in: canvas
}

