import "../../examples/design_system.fd" as ds

# ─── Styles ───

style flow_edge {
}

style screen {
  fill: #FFFFFF  # white
  corner: 16
}

style screen_title {
  fill: #1A1A2E  # blue
  font: "Inter" bold 20
}

# ─── Layout ───

# ─── Screens ────────────────────────────────────────────────
# [auto] styled: screen
rect @landing {
  spec {
    Marketing landing page
    status: done
    tag: marketing
  }
  text @landing_t "Landing Page" {
    use: screen_title
  }
  w: 200 h: 120
  use: screen
  x: 40
  y: 200
}

# [auto] styled: screen
rect @signup {
  spec {
    Registration form
    todo: "collects name, email, password"
    todo: "OAuth buttons for Google + GitHub"
    status: done
  }
  text @signup_t "Sign Up" {
    use: screen_title
  }
  w: 200 h: 120
  use: screen
  x: 300
  y: 200
}

# [auto] styled: screen
rect @verify_email {
  spec {
    Email verification step
    todo: "shows 6-digit OTP input"
    todo: "resend link after 60s cooldown"
    status: doing
  }
  text @verify_t "Verify Email" {
    use: screen_title
  }
  w: 200 h: 120
  use: screen
  x: 560
  y: 200
}

# [auto] styled: screen
rect @setup_profile {
  spec {
    Profile setup — avatar, bio, preferences
    todo: "avatar upload with crop"
    status: todo
  }
  text @setup_t "Setup Profile" {
    use: screen_title
  }
  w: 200 h: 120
  use: screen
  x: 820
  y: 200
}

# [auto] styled: screen
rect @dashboard {
  spec {
    Main application dashboard
    status: todo
    tag: core
  }
  text @dash_t "Dashboard" {
    use: screen_title
  }
  w: 200 h: 120
  use: screen
  x: 1080
  y: 200
}

# [auto] connects to signup
rect @error_screen {
  spec "Generic error state"
  text @error_t "Error" {
    fill: #B91C1C  # red
    font: "Inter" semibold 16
  }
  w: 160 h: 100
  fill: #FEF2F2  # white
  corner: 12
  x: 300
  y: 420
}

# [auto] connects to verify_email
rect @resend_screen {
  spec "Resend verification email"
  text @resend_t "Resend Email" {
    fill: #92400E  # orange
    font: "Inter" semibold 14
  }
  w: 160 h: 100
  fill: #FFFBEB  # yellow
  corner: 12
  x: 560
  y: 420
}

text @_cta_click_label "Get Started" {
}

text @_signup_submit_label "submit" {
}

text @_email_verified_label "verified" {
}

text @_profile_done_label "complete" {
}

text @_signup_error_label "validation fail" {
}

text @_verify_timeout_label "expired" {
}

text @_resend_retry_label "resend" {
}

text @_error_retry_label "retry" {
}

text @_cta_click_label "Get Started" {
}

text @_signup_submit_label "submit" {
}

text @_email_verified_label "verified" {
}

text @_profile_done_label "complete" {
}

text @_signup_error_label "validation fail" {
}

text @_verify_timeout_label "expired" {
}

text @_resend_retry_label "resend" {
}

text @_error_retry_label "retry" {
}

# ─── Flows ───

edge @cta_click @landing -> @signup {
  spec "Primary CTA on landing"
  text @_cta_click_label "Get Started" {}
  stroke: #6C5CE7 2
  arrow: end
}
edge @signup_submit @signup -> @verify_email {
  spec {
    Form submission
    todo: "validates all fields client-side first"
  }
  text @_signup_submit_label "submit" {}
  stroke: #6C5CE7 2
  arrow: end
}
edge @email_verified @verify_email -> @setup_profile {
  spec "OTP validated"
  text @_email_verified_label "verified" {}
  stroke: #10B981 2
  arrow: end
  curve: smooth
}
edge @profile_done @setup_profile -> @dashboard {
  spec "Profile setup complete"
  text @_profile_done_label "complete" {}
  stroke: #10B981 2
  arrow: end
  curve: smooth
}
edge @signup_error @signup -> @error_screen {
  spec {
    Registration failure
    todo: "shows inline field errors"
  }
  text @_signup_error_label "validation fail" {}
  stroke: #EF4444 1
  arrow: end
  curve: step
}
edge @verify_timeout @verify_email -> @resend_screen {
  spec "OTP expired or invalid"
  text @_verify_timeout_label "expired" {}
  stroke: #F59E0B 1
  arrow: end
  curve: step
}
edge @resend_retry @resend_screen -> @verify_email {
  spec "User requests new OTP"
  text @_resend_retry_label "resend" {}
  stroke: #F59E0B 1
  arrow: end
}
edge @error_retry @error_screen -> @signup {
  spec "User corrects errors and resubmits"
  text @_error_retry_label "retry" {}
  stroke: #6B7280 1
  arrow: end
}
