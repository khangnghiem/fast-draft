{
  "productName": "Fast Draft",
  "version": "0.1.0",
  "identifier": "com.fast-draft.desktop",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../site && npx -y serve -l 1420 -s --no-clipboard --no-port-switching &",
    "beforeBuildCommand": "bash src-tauri/scripts/prebuild.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Fast Draft",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Design as Code — AI-native visual editor",
    "longDescription": "Fast Draft is an AI-native design tool that bridges code and canvas. Write .fd markup to create visual designs, or draw on the canvas and get clean code back. Features include a constraint-based layout engine, bidirectional sync, and an AI design agent.",
    "copyright": "© 2026 Khang Nghiêm",
    "fileAssociations": [
      {
        "ext": ["fd"],
        "mimeType": "text/plain",
        "description": "Fast Draft Document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "icons/dmg_bg.png",
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      },
      "signingIdentity": null,
      "entitlements": null,
      "frameworks": []
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"],
        "section": "graphics",
        "priority": "optional"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://fast-draft.com/api/update/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/khangnghiem/fast-draft/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NUNBMEEwMUMxQUI5MkEKUldRcXVSb2NvS0JjNXlMTmVOWFNKeldoNFlpWmd2Nmk5cjVYQzhtd01Sa09JYTNqZmVTTlY4SUMK"
    }
  }
}
