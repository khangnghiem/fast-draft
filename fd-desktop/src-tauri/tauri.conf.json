{
  "productName": "Fast Draft",
  "version": "0.1.0",
  "identifier": "com.fast-draft.desktop",
  "build": {
    "frontendDist": "../../site",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Fast Draft",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://fast-draft.com/api/update/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/khangnghiem/fast-draft/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NUNBMEEwMUMxQUI5MkEKUldRcXVSb2NvS0JjNXlMTmVOWFNKeldoNFlpWmd2Nmk5cjVYQzhtd01Sa09JYTNqZmVTTlY4SUMK"
    }
  }
}
